# MaterialX-in-MTL example
newmtl painted metal.001
Kd 0.8 0.2 0.1
mtlx_version 1.39
mtlx_surface shader open_pbr_surface
mtlx_node tex image color3
mtlx_node rgh image float
mtlx_input tex.file filename "paint 01.png"
mtlx_input rgh.file filename rough.png
mtlx_input shader.base_metalness float 1.0
mtlx_input shader.base_color color3 0.8 0.2 0.1
connectmtl tex shader.base_color
connectmtl rgh.out shader.specular_roughness

newmtl plain
Kd 1 1 1

newmtl cycle
mtlx_surface s standard_surface
mtlx_node a multiply color3
mtlx_node b multiply color3
connectmtl a b.in1
connectmtl b a.in1
connectmtl a s.base_color

newmtl badtype
mtlx_surface s standard_surface
mtlx_input s.base float 1 2
